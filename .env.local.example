# ---- Publicas (viajan al navegador) ----
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
NEXT_PUBLIC_WHATSAPP_NUMBER=5493875555555

# Dominio canonico, sin barra final. Resuelve las URLs absolutas de la OG
# image, el canonical y el JSON-LD. Si no se define, se usa
# https://www.nutrirsehoy.com (el de produccion).
NEXT_PUBLIC_SITE_URL=https://www.nutrirsehoy.com

# Opcionales. Google Analytics (G-XXXXXXX) y Pixel de Meta. Son IDs
# publicos, no secretos. Solo se cargan si el visitante acepta las cookies.
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=

# ---- Privadas (solo servidor) ----
# NUNCA les pongas el prefijo NEXT_PUBLIC_: quedarian en el bundle publico.

# Supabase > Project Settings > API > service_role.
# Ignora RLS: es la llave maestra del proyecto.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Contraseña de acceso a /admin.
ADMIN_PASSWORD=una-clave-larga-y-random

# Opcional. Firma la cookie de sesion del panel.
# Si no se define, se firma con ADMIN_PASSWORD (y rotar la clave cierra
# todas las sesiones abiertas, que suele ser lo deseado).
# ADMIN_SESSION_SECRET=otro-string-random-largo
